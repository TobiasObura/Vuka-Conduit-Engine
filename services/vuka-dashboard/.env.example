# Vuka Treasury Dashboard -- environment variables
# Only what's specific to the dashboard process. It also needs SESSION_SECRET
# set to the SAME value as the backend if you want it to decrypt phone numbers
# for compliance review (see crypto_utils.py) -- a mismatched or missing
# SESSION_SECRET here just means phone numbers show as-stored, it won't error.

SESSION_SECRET=                             # must match the backend's value
VUKA_DB_PATH=                               # defaults to ../ussd-backend/app/data/vuka.db

VUKA_MLRO_NAME=                             # must match backend's value to show consistently
VUKA_MLRO_EMAIL=

# --- WhatsApp Business API low-float alerts (non-blocking) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TREASURY_WHATSAPP_NUMBER=

# --- Gemini AI (non-blocking -- reached via the backend's app package, see app.py) ---
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
