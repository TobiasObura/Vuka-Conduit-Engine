# Vuka USSD Backend -- environment variables
# Copy to .env (or set as Replit Secrets) and fill in as each integration is ready.
# Nothing here is required to run in simulation mode -- the app boots and works
# fully simulated with zero configuration. Each block below activates the
# moment its variables are set; see app/config.py's simulation_summary() for
# a live readout of what's currently real vs simulated.

# -----------------------------------------------------------------------------
# BLOCKER for go-live: none of the sections below are optional for real money
# movement. See GO_LIVE_CHECKLIST.md for the non-code prerequisites (signed
# partner agreements, designated MLRO, etc.) that have to exist before these
# credentials even make sense to request.
# -----------------------------------------------------------------------------

# --- Payout: Thunes DGN (primary, all corridors) ---
# Issued by Thunes after their compliance review of Vuka as a business.
THUNES_API_KEY=
THUNES_API_SECRET=
THUNES_PAYER_ID=
THUNES_ENVIRONMENT=pre-production          # set to "production" when live
# Per-corridor wallet-provider service IDs, assigned by Thunes during onboarding
THUNES_SERVICE_ID_KENYA=
THUNES_SERVICE_ID_UGANDA=
THUNES_SERVICE_ID_TANZANIA=
THUNES_SERVICE_ID_RWANDA=
THUNES_SERVICE_ID_GHANA=
THUNES_CALLBACK_URL=                        # auto-derives from REPLIT_DOMAINS if unset -> /ussd/webhook/thunes-callback
THUNES_WEBHOOK_SECRET=                      # optional HMAC secret for verifying callbacks

# Thunes Accept API -- Tier 2 collection (HOST_TO_HOST USSD push), distinct from
# THUNES_PAYER_ID. Lets Vuka run single-provider (Thunes for both legs) once set.
THUNES_MERCHANT_ID=
THUNES_COLLECTION_CALLBACK_URL=             # auto-derives -> /ussd/webhook/thunes-collection-callback

# Thunes x Circle USDC settlement (convert-on-payout). Both required to activate.
THUNES_USDC_MODE=false
THUNES_ACCOUNT_ID=

# --- Collection: Onafriq hub (all non-Safaricom senders) ---
ONAFRIQ_API_KEY=
ONAFRIQ_BASE_URL=https://mfsafrica.beyonicpartners.com
ONAFRIQ_CALLBACK_URL=                       # auto-derives from REPLIT_DOMAINS if unset

# --- Collection: Safaricom Daraja (Safaricom Kenya senders only) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox                          # set to "production" when live
DARAJA_CALLBACK_URL=                        # auto-derives from REPLIT_DOMAINS if unset

# --- Funded settlement (optional Daraja B2B leg) ---
# Discuss the Thunes pre-funding mechanism with Thunes during onboarding
# BEFORE configuring this -- see replit.md.
BANK_SETTLEMENT_SHORTCODE=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=

# --- Payout fallback: per-corridor bank plugin gateway (only if Thunes isn't configured) ---
# BANK_PARTNER_<CORRIDOR>_GATEWAY_URL=
# BANK_PARTNER_<CORRIDOR>_SIGNING_SECRET=
# BANK_PARTNER_<CORRIDOR>_NAME=
# Replace <CORRIDOR> with KENYA / UGANDA / TANZANIA / RWANDA / GHANA

# --- SMS OTP delivery ---
AT_USERNAME=
AT_API_KEY=

# --- Encryption at rest (BLOCKER: phone numbers are stored in PLAINTEXT until this is set) ---
SESSION_SECRET=

# --- Compliance ---
# BLOCKER: a designated human. No placeholder value is ever treated as real --
# the dashboard will show an explicit "not designated" warning until both are set.
VUKA_MLRO_NAME=
VUKA_MLRO_EMAIL=

# Real name-based sanctions/PEP screening. See sanctions_screening.py --
# this is the single biggest go-live blocker in the whole compliance layer.
# The local phone-number watchlist below is NOT a substitute for this.
SANCTIONS_VENDOR_ENABLED=false
SANCTIONS_VENDOR_BASE_URL=
SANCTIONS_VENDOR_API_KEY=
SANCTIONS_VENDOR_MATCH_THRESHOLD=85

# Manually curated phone-number watchlist -- explicitly NOT a real sanctions list.
# Comma-separated, e.g. VUKA_LOCAL_WATCHLIST=+254700000000,+256700000000
VUKA_LOCAL_WATCHLIST=

COMPLIANCE_VELOCITY_THRESHOLD=3
COMPLIANCE_VELOCITY_WINDOW_MINUTES=60
COMPLIANCE_LARGE_AMOUNT_FRACTION=0.8

# Tiered risk-based due diligence (SDD/CDD/EDD) -- see compliance.determine_tier().
# Below this fraction of a corridor's soft cap: LOW tier (watchlist + sanctions
# vendor only). Between this and COMPLIANCE_LARGE_AMOUNT_FRACTION: STANDARD
# (bank-partner screening backgrounded). At/above COMPLIANCE_LARGE_AMOUNT_FRACTION:
# ENHANCED (everything synchronous).
VUKA_SDD_LOW_TIER_FRACTION=0.05

# How long the FX rate quoted at USSD confirmation stays valid before
# complete_transfer() refunds instead of settling at a stale rate.
VUKA_RATE_LOCK_SECONDS=300

# Gateway cost allowance (Thunes FX spread + API commission) absorbed within
# Vuka's own margin.
BANK_SETTLEMENT_BPS=50

# Per-corridor opt-in to delegate sanctions/PEP screening to that corridor's
# own bank/MTO partner. Requires the partner to have confirmed they expose
# POST {gateway_url}/compliance-screen -- see COMPLIANCE_SCREENING_OVERVIEW.md.
# BANK_PARTNER_<CORRIDOR>_COMPLIANCE_ENABLED=true

# --- Gemini AI (non-blocking -- advisory/UX only) ---
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=

# --- Misc ---
VUKA_DB_PATH=                               # defaults to app/data/vuka.db

# --- Rafiki (NALA) -- redundant payout fallback, not a Thunes replacement ---
# Only used when a live Thunes dispatch attempt fails at runtime. NALA has no
# public developer API docs as of this writing -- confirm the real endpoint
# contract with NALA directly before setting these.
RAFIKI_API_KEY=
RAFIKI_SECRET=
